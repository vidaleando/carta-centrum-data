# PostgreSQL + PostGIS connection (required unless DEMO_MODE=true)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gisdb

# Serve static sample data with no database
DEMO_MODE=false

# Comma-separated allowed origins; leave empty when the frontend is same-origin
CORS_ORIGINS=

# Needed by `python -m importers.mps`
THEYWORKFORYOU_KEY=

# Invite-only access (Supabase Auth). Off by default for local development.
AUTH_ENABLED=false
SUPABASE_URL=
# Only for `python -m tools.invite` on your machine. Never deploy it.
SUPABASE_SECRET_KEY=
SITE_URL=https://carta-centrum-data.vercel.app
